{
  "name": "Trading App — Linux/amd64 Dev Container",
  "build": {
    "dockerfile": "../Dockerfile.dev",
    "context": "..",
    // linux/amd64 matches the EC2 target; Rosetta 2 on Apple Silicon
    // handles the emulation transparently.
    "args": {}
  },
  "runArgs": [
    "--platform=linux/amd64"
  ],
  // Mount the workspace so edits in Cursor are immediately visible
  // inside the container without a rebuild.
  "workspaceMount": "source=${localWorkspaceFolder},target=/app,type=bind,consistency=cached",
  "workspaceFolder": "/app",
  // Re-build the C++ engine after the workspace is first mounted —
  // the COPY in Dockerfile.dev bakes a snapshot; this ensures the
  // mounted source is always compiled.
  "postCreateCommand": "bash backtestingCpp/orderflow/build.sh",
  "remoteEnv": {
    "PYTHONUNBUFFERED": "1",
    "VIRTUAL_ENV": "/app/.venv",
    "PATH": "/app/.venv/bin:${containerEnv:PATH}"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.pylance",
        "ms-vscode.cmake-tools",
        "ms-vscode.cpptools"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/app/.venv/bin/python",
        "python.terminal.activateEnvironment": true
      }
    }
  },
  // Expose nothing by default; add ports here if a service needs to be
  // reached from the host (e.g. a metrics endpoint).
  "forwardPorts": []
}
