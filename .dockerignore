# Keep Docker build contexts small.
.git
.github
.idea
.venv
.pytest_cache
__pycache__/
**/__pycache__/
*.pyc
*.pyo

# Local-only runtime artefacts
logs/
reports/
build/
# C++ build artefacts compiled on the host — contain absolute macOS paths that
# cause CMake to fail when re-used inside Docker (/Users/... vs /app/...).
backtestingCpp/orderflow/build/
*.h5
*.so
data/*.h5
data/binance*
data/oanda*
data/ohlcv/
data/optimised_parameters.h5
data/BTCUSDT_strategy.h5

# UI build artefacts (each ui Dockerfile rebuilds from source)
ui/node_modules/
ui/dist/
ui/.vite/

# Docs and tooling that have no business inside an image
*.md
docs/
tools/
tests/
TESTING_GUIDE.md
implementation_plan.md
UI_STRATEGY_INTEGRATION_PLAN.md

# Local env
.env
.env.local
