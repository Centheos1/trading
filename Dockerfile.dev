# Development / CI image — Ubuntu 24.04, linux/amd64.
#
# Matches the EC2 t3.small (data collection) and g5.xlarge (UI) OS baseline.
# The C++ orderflow_engine is compiled inside this image — same binary
# locally (Docker Desktop + Rosetta on macOS) and on EC2 (native).
#
# GUI usage:
#   Tests     → QT_QPA_PLATFORM=offscreen (set in devcontainer.json / CI)
#   Local GUI → mount X11 socket or use XQuartz on macOS
#   EC2 GUI   → see Dockerfile.gpu; requires nvidia-container-toolkit
#
# Build:
#   docker build -f Dockerfile.dev -t trading-app-dev .
# Run tests:
#   docker run --rm trading-app-dev
# Open a shell:
#   docker run --rm -it -v "$(pwd)":/app trading-app-dev bash

FROM ubuntu:24.04

ARG DEBIAN_FRONTEND=noninteractive
ARG PYTHON_VERSION=3.12

# ---------------------------------------------------------------------------
# System packages
# ---------------------------------------------------------------------------
# Enable universe repo — required for many packages on Ubuntu 24.04 base image
RUN apt-get update && apt-get install -y --no-install-recommends software-properties-common \
    && add-apt-repository universe \
    && apt-get update \
    && rm -rf /var/lib/apt/lists/*

RUN apt-get update && apt-get install -y --no-install-recommends \
    # Build tools
    build-essential \
    cmake \
    git \
    pkg-config \
    # C++ engine dependencies
    libboost-all-dev \
    libhdf5-dev \
    libssl-dev \
    nlohmann-json3-dev \
    # Python
    python${PYTHON_VERSION} \
    python${PYTHON_VERSION}-venv \
    python${PYTHON_VERSION}-dev \
    python3-pip \
    # Qt / PySide6 runtime (headless + XCB for X11 passthrough)
    libgl1 \
    libglib2.0-0 \
    libdbus-1-3 \
    libfontconfig1 \
    libxcb-cursor0 \
    libxcb-icccm4 \
    libxcb-image0 \
    libxcb-keysyms1 \
    libxcb-randr0 \
    libxcb-render-util0 \
    libxcb-shape0 \
    libxcb-xinerama0 \
    libxcb-xkb1 \
    libxkbcommon-x11-0 \
    libxkbcommon0 \
    # Headless display for Qt tests
    xvfb \
    # Utilities
    curl \
    unzip \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# AWS CLI v2 — not available as an apt package on Ubuntu 24.04
RUN curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o /tmp/awscliv2.zip \
    && unzip -q /tmp/awscliv2.zip -d /tmp \
    && /tmp/aws/install \
    && rm -rf /tmp/awscliv2.zip /tmp/aws

# pybind11 needs to be findable by CMake; install system dev package as well
RUN apt-get update && apt-get install -y --no-install-recommends \
    pybind11-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# ---------------------------------------------------------------------------
# C++ orderflow_engine — build first so changes to requirements.txt do not
# bust this expensive layer (~15 min on t3.small).
#
# A minimal venv with just pybind11 is created first so build.sh can locate
# pybind11's CMake directory. The full requirements install comes after so
# that pip changes never invalidate the C++ build cache.
# ---------------------------------------------------------------------------
COPY backtestingCpp/ backtestingCpp/

RUN python${PYTHON_VERSION} -m venv .venv \
    && .venv/bin/pip install --quiet pybind11

RUN bash backtestingCpp/orderflow/build.sh

# ---------------------------------------------------------------------------
# Python virtual environment (full) — after C++ so pip changes don't trigger
# a full C++ recompile.
# ---------------------------------------------------------------------------
COPY requirements.txt requirements-collector.txt ./

RUN .venv/bin/pip install --upgrade pip setuptools wheel \
    && .venv/bin/pip install -r requirements.txt

ENV PATH="/app/.venv/bin:${PATH}" \
    VIRTUAL_ENV="/app/.venv"

# ---------------------------------------------------------------------------
# Application source
# ---------------------------------------------------------------------------
COPY . .

# ---------------------------------------------------------------------------
# Runtime defaults
# Overridden by devcontainer.json (offscreen) or Dockerfile.gpu (xcb+opengl)
# ---------------------------------------------------------------------------
ENV QT_QPA_PLATFORM=offscreen \
    QSG_RHI_BACKEND=software \
    PYTHONUNBUFFERED=1

# Default: run the full test suite (CI / smoke check)
CMD ["python", "-m", "unittest", "discover", "-s", "tests", "-v"]
