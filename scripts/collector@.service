# Template unit for running multiple symbols as separate service instances.
# Instantiate with: sudo systemctl start collector@ETHUSDT
# See: scripts/add_symbol.sh

[Unit]
Description=Binance Tick Data Collector — %i
Documentation=file:///app/docs/DEPLOYMENT.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/app
EnvironmentFile=/app/.env
# --max-h5-gb and --parquet-flush-interval are intentionally omitted:
# collect_ticks.py defaults them from $MAX_H5_GB (else 3 GB) and
# $PARQUET_FLUSH_INTERVAL (else 60 s) via EnvironmentFile=/app/.env, so both
# are tuned from .env alone, consistent with docker-compose. $MIN_FREE_DISK_GB
# (else 2 GB) likewise drives the free-disk rotation floor. See
# _default_max_h5_gb() / _default_parquet_flush_interval() / _min_free_disk_gb()
# in collect_ticks.py and docs/DEPLOYMENT.md.
ExecStart=/app/.venv/bin/python /app/collect_ticks.py \
    --symbol %i \
    --s3-bucket ${S3_BUCKET} \
    --data-dir data \
    --log-level INFO
# Restart on any non-zero exit — including EXIT_ROTATE (75) which is
# emitted by collect_ticks.py after archiving a full HDF5 file.
Restart=on-failure
RestartSec=30
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal
SyslogIdentifier=collector@%i

[Install]
WantedBy=multi-user.target
