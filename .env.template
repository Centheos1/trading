# Copy this file to .env and fill in the values before running docker compose.
#   cp .env.template .env

# ── Data collection ───────────────────────────────────────────────────────────
# S3 bucket for HDF5 uploads (leave blank to disable upload — data stays local)
S3_BUCKET=

# Primary symbol for the default collector service
SYMBOLS=BTCUSDT

# Collector log verbosity (DEBUG / INFO / WARNING / ERROR)
LOG_LEVEL=INFO

# ── Binance API keys ──────────────────────────────────────────────────────────
# Only required for execution mode (live/paper trading), not for data collection
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=false

# ── Qt display (local GUI only) ───────────────────────────────────────────────
# macOS + XQuartz: set DISPLAY=host.docker.internal:0 before docker compose up
# Linux / EC2 with X11 forwarding: set DISPLAY=:0 or leave blank
DISPLAY=
QT_QPA_PLATFORM=xcb
QSG_RHI_BACKEND=opengl
