# Copy this file to .env and fill in the values before running docker compose.
#   cp .env.template .env

# ── Data collection (collector EC2) ───────────────────────────────────────────
# S3 bucket for Parquet shard / OHLCV uploads
S3_BUCKET=trading-data-centheos

# Comma-separated symbols (used by health cron / legacy-multi profile)
SYMBOLS=BTCUSDT,ETHUSDT

# Venue id for tick collectors and Redis Streams (md:{venue}:*)
MD_VENUE=binance

# Collector log verbosity (DEBUG / INFO / WARNING / ERROR)
LOG_LEVEL=INFO

# Seconds between immutable Parquet shard flushes (crash loss window).
PARQUET_FLUSH_INTERVAL=60

# Refuse to write a new shard when the data volume has less than this many
# GB free. Closed shards are uploaded to S3 and deleted after HeadObject
# confirms the size, so local disk should only hold unconfirmed files.
MIN_FREE_DISK_GB=2

# ── Live bus (ElastiCache in prod; bundled redis profile for laptop) ──────────
# Prod REQUIRED: redis://YOUR_ELASTICACHE:6379
# Dev with compose profile bundled-redis: redis://redis:6379
REDIS_URL=redis://redis:6379

# ── Pipeline health alarm (scripts/pipeline_health.sh, hourly cron) ───────────
HEALTH_MAX_STALENESS_SECONDS=300
HEALTH_MAX_STALENESS_HOURS=2
S3_SYNC_MAX_AGE_MIN=120
ALERT_WEBHOOK_URL=
ALERT_SNS_TOPIC_ARN=
CLOUDWATCH_NAMESPACE=Trading/Pipeline

# ── OHLCV historical-data store ───────────────────────────────────────────────
#   local_parquet — Parquet under data/ohlcv/        (local / small sets only)
#   s3            — direct read/write to S3_BUCKET   (REQUIRED on EC2)
DATA_STORE=s3

OHLCV_EXCHANGE=all
OHLCV_TIMEFRAME=1m
OHLCV_FROM_DATE=2020-01-01
OHLCV_MODE=continuous
OHLCV_POLL_INTERVAL=3600
# Keep at 2 on shared collector host so ticks stay resident.
OHLCV_WORKERS=2

# ── Oanda API ─────────────────────────────────────────────────────────────────
OANDA_ACCOUNT_ID=
OANDA_ACCESS_TOKEN=
OANDA_ACCOUNT_TYPE=practice

# ── Binance API keys (execution host only — not needed on collector) ──────────
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=false

REDIS_URL=
