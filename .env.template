# Copy this file to .env and fill in the values before running docker compose.
#   cp .env.template .env

# ── Data collection ───────────────────────────────────────────────────────────
# S3 bucket for HDF5/Parquet uploads (leave blank to disable upload — data stays local)
S3_BUCKET=

# Primary symbol for the default collector service
SYMBOLS=BTCUSDT

# Collector log verbosity (DEBUG / INFO / WARNING / ERROR)
LOG_LEVEL=INFO

# ── OHLCV historical-data store ───────────────────────────────────────────────
# Backend used by ohlcv_store and the backtest reader.
#   local_parquet — Parquet under data/ohlcv/ (recommended for local dev)
#   s3            — direct read/write to s3://${S3_BUCKET}/ohlcv/   (EC2 prod)
DATA_STORE=local_parquet

# Defaults consumed by the ohlcv-collector service (docker-compose.yml).
# Override only if you need to limit the scope of collection.
OHLCV_EXCHANGE=all
OHLCV_TIMEFRAME=1m
OHLCV_FROM_DATE=2020-01-01
OHLCV_MODE=continuous
OHLCV_POLL_INTERVAL=3600
OHLCV_WORKERS=4

# ── Oanda API ─────────────────────────────────────────────────────────────────
# Required for Oanda OHLCV collection (FX, indices, commodities, crypto, bonds).
# Get a personal access token from: https://www.oanda.com/account/tpa/personal_token
OANDA_ACCOUNT_ID=
OANDA_ACCESS_TOKEN=
OANDA_ACCOUNT_TYPE=practice

# ── Binance API keys ──────────────────────────────────────────────────────────
# Only required for execution mode (live/paper trading), not for data collection
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=false

# ── Qt display (local GUI only) ───────────────────────────────────────────────
# macOS + XQuartz: set DISPLAY=host.docker.internal:0 before docker compose up
# Linux / EC2 with X11 forwarding: set DISPLAY=:0 or leave blank
DISPLAY=
QT_QPA_PLATFORM=xcb
QSG_RHI_BACKEND=opengl
