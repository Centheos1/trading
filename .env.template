# Copy this file to .env and fill in the values before running docker compose.
#   cp .env.template .env

# ── Data collection ───────────────────────────────────────────────────────────
# S3 bucket for HDF5/Parquet uploads (leave blank to disable upload — data stays local)
S3_BUCKET=

# Comma-separated symbols for the tick collector service
SYMBOLS=BTCUSDT,ETHUSDT

# Collector log verbosity (DEBUG / INFO / WARNING / ERROR)
LOG_LEVEL=INFO

# Rotate the live HDF5 file when it exceeds this many GB (per symbol). Honoured
# by both docker-compose and the systemd/direct invocation paths.
# Keep n_symbols × MAX_H5_GB comfortably below the data volume's free space —
# the collector logs a disk-headroom warning at startup if it would not fit,
# because a full disk corrupts the live HDF5 (the failure rotation prevents).
# On a 30 GB root with 2 symbols, 8 is the tested default. Raise only after
# growing the EBS volume. See docs/DEPLOYMENT.md "HDF5 rotation cadence".
MAX_H5_GB=8

# Seconds between HDF5 → Parquet mirror flushes (0 disables the mirror).
PARQUET_FLUSH_INTERVAL=900

# ── Pipeline health alarm (scripts/pipeline_health.sh, hourly cron) ───────────
# Grace period after 00:00 UTC before yesterday's Parquet day-file is treated
# as stale (today's file appears on the first flush of the new UTC day).
HEALTH_MAX_STALENESS_HOURS=2
# Max age (minutes) of a successful s3_sync run before the alarm flags the
# sync cron as dead.
S3_SYNC_MAX_AGE_MIN=120
# Optional alerting on failure. Leave blank to rely on cron mail / logs only.
#   ALERT_WEBHOOK_URL    — Slack/Discord-style endpoint; POSTed {"text": "..."}
#   ALERT_SNS_TOPIC_ARN  — AWS SNS topic; requires sns:Publish on the IAM role
ALERT_WEBHOOK_URL=
ALERT_SNS_TOPIC_ARN=

# ── OHLCV historical-data store ───────────────────────────────────────────────
# Backend used by ohlcv_store and the backtest reader.
#   local_parquet — Parquet under data/ohlcv/        (local dev / small sets only)
#   s3            — direct read/write to S3_BUCKET   (REQUIRED on EC2 / --all-symbols)
#
# WARNING: The ohlcv-collector service runs --all-symbols (300+ Binance perps +
# 70+ Oanda instruments, 5+ years at 1m).  Using local_parquet here will fill
# the EC2 disk within hours and kill ALL services.
# Always set DATA_STORE=s3 on EC2.  The collector will abort at startup if it
# detects local_parquet with --all-symbols.
DATA_STORE=s3

# Defaults consumed by the ohlcv-collector service (docker-compose.yml).
# Override only if you need to limit the scope of collection.
OHLCV_EXCHANGE=all
OHLCV_TIMEFRAME=1m
OHLCV_FROM_DATE=2020-01-01
# OHLCV runs at a deliberately low concurrency: it is re-fetchable and must
# never compete with the (irreplaceable) tick collector for memory on the
# shared host. The ohlcv-collector container is also hard-capped in
# docker-compose.yml. Raise only on a dedicated/large instance.
OHLCV_MODE=continuous
OHLCV_POLL_INTERVAL=3600
OHLCV_WORKERS=2

# ── Oanda API ─────────────────────────────────────────────────────────────────
# Required for Oanda OHLCV collection (FX, indices, commodities, crypto, bonds).
# All three variables MUST be set — the collector fails at startup if any are
# missing, so problems are caught immediately rather than silently skipping Oanda.
#
# OANDA_ACCOUNT_ID    — numeric account ID (e.g. 123-456-7890123-456)
# OANDA_ACCESS_TOKEN  — personal access token from
#                       https://www.oanda.com/account/tpa/personal_token
# OANDA_ACCOUNT_TYPE  — "practice" (demo) or "live"
#                       Routes API calls to the correct endpoint:
#                         practice → api-fxpractice.oanda.com
#                         live     → api-fxtrade.oanda.com
OANDA_ACCOUNT_ID=
OANDA_ACCESS_TOKEN=
OANDA_ACCOUNT_TYPE=practice

# ── Binance API keys ──────────────────────────────────────────────────────────
# Only required for execution mode (live/paper trading), not for data collection
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=false
